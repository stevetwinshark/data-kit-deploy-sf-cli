# Env vars and deploy-kit.sh flags take precedence over this file.
export KIT="MyDataKitDevName"      # Data Kit developer name
export SOURCE_ORG="source-sandbox"          # sf org alias to retrieve from
export TARGET_ORG="target-sandbox"        # sf org alias to deploy to
